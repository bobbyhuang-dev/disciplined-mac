{
  "manifest_version": 3,
  "name": "Disciplined",
  "version": "1.0",
  "description": "Blocks the websites on your Disciplined list.",
  "key": "",
  "permissions": ["declarativeNetRequest", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
