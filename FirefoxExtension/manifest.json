{
  "manifest_version": 2,
  "name": "Disciplined",
  "version": "1.0",
  "description": "Blocks the websites on your Disciplined list.",
  "browser_specific_settings": {
    "gecko": { "id": "disciplined@disciplined.mac", "strict_min_version": "128.0" }
  },
  "permissions": ["declarativeNetRequest", "nativeMessaging", "alarms", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "web_accessible_resources": ["blocked.html"]
}
